{
  "name": "mtg-tournament-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "scripts": {
    "check": "node --check ../assets/web/app.js && npm run typecheck && npm test",

    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.2",
    "@cloudflare/workers-types": "5.20260804.1",
    "typescript": "5.9.2",
    "vitest": "4.1.10",
    "wrangler": "4.119.0"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mtg-tournament-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "../assets/web",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RelayRoom"
      },
      {
        "name": "PROVISION_LIMITERS",
        "class_name": "ProvisionLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom", "ProvisionLimiter"]
    }
  ]
}
